<div class="auth-card">
  <h1 class="auth-title">新規登録</h1>

  <%= form_with(model: resource, url: registration_path(resource_name), local: true, class: "auth-form") do |f| %>
    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email, autofocus: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password %>
      <%= f.password_field :password, autocomplete: "new-password", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.submit "登録", class: "primary-btn" %>
    </div>
  <% end %>

  <div class="auth-links">
    <%= link_to "ログインはこちら", new_user_session_path, class: "secondary-btn" %>
  </div>
</div>