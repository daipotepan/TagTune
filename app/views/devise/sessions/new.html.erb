<div class="auth-card">
  <h1>ログイン</h1>

  <%= form_with scope: :user, url: user_session_path, local: true do |f| %>
    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password %>
      <%= f.password_field :password, class: "form-input" %>
    </div>

    <%= f.submit "ログイン", class: "btn btn-primary full" %>
  <% end %>

  <hr>

  <%= button_to "🎧 ゲストログイン（登録不要）",
    users_guest_sign_in_path,
    method: :post,
    class: "btn btn-outline full guest-btn" %>
</div>