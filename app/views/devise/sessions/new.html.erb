<div class="auth-card">
  <h1 class="auth-title">ログイン</h1>

  <%= form_with(model: resource, url: session_path(resource_name), local: true, class: "auth-form") do |f| %>
    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email, autofocus: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password %>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.submit "ログイン", class: "primary-btn" %>
    </div>
  <% end %>

  <div class="auth-links">
    <%= link_to "新規登録はこちら", new_user_registration_path, class: "secondary-btn" %>
    <%= link_to "パスワードを忘れた方", new_user_password_path, class: "secondary-btn" %>
  </div>
</div>