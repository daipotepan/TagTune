<div class="song-show-card">
  <h1 class="song-title"><%= @song.title %></h1>
  <p class="song-artist"><%= @song.artist %></p>

  <div class="song-tags">
    <% @song.tags.each do |tag| %>
      <span class="tag"><%= tag.name %></span>
    <% end %>
  </div>

  <div class="song-actions">
    <%= link_to "▶ Spotifyで開く",
        @song.spotify_url,
        target: "_blank",
        rel: "noopener",
        class: "spotify-play-btn" %>

    <%= link_to "編集", edit_song_path(@song), class: "secondary-btn" %>
    <%= link_to "削除",
        song_path(@song),
        data: {
          turbo_method: :delete,
          turbo_confirm: "削除しますか？"
        },
        class: "danger-btn" %>
  </div>
</div>
