<h1 class="page-title">🎵 プレイリストと曲一覧</h1>

<% if user_signed_in? %>
  <% if @playlists.any? %>
    <% @playlists.each do |playlist| %>
      <div class="playlist">
        <h2><%= playlist.name %></h2>
        <%= link_to "＋ 曲を追加", new_playlist_playlist_song_path(playlist), class: "add-song-btn" %>

        <div class="table-wrapper">
          <table class="songs-table">
            <thead>
              <tr>
                <th>タイトル</th>
                <th>アーティスト</th>
                <th>Spotify</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              <% playlist.songs.each do |song| %>
                <tr>
                  <td><%= song.title %></td>
                  <td class="muted"><%= song.artist %></td>
                  <td>
                    <%= link_to "▶ 開く", song.spotify_url, target: "_blank", rel: "noopener", class: "spotify-link" %>
                  </td>
                  <td class="actions">
                    <%= link_to edit_song_path(song), class: "icon-btn edit", title: "編集" do %>✏️<% end %>
                    <%= link_to song_path(song), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "icon-btn delete", title: "削除" do %>🗑<% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% else %>
    <p>プレイリストがありません。</p>
    <%= link_to "新しいプレイリストを作成", new_playlist_path, class: "btn" %>
  <% end %>
<% else %>
  <p>ログインしてください</p>
<% end %>