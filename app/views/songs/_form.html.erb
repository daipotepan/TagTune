<div class="form-card">
  <% if song.errors.any? %>
    <div class="error-messages">
      <h3>入力内容を確認してください</h3>
      <ul>
        <% song.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: song, local: true do |f| %>
    <div class="form-group">
      <%= f.label :title, "曲名" %>
      <%= f.text_field :title, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :artist, "アーティスト" %>
      <%= f.text_field :artist, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :spotify_url, "Spotify URL" %>
      <%= f.text_field :spotify_url, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :tags, "タグ" %>
      <div class="tag-checkboxes">
        <%= f.collection_check_boxes :tag_ids, Tag.all, :id, :name %>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit "保存", class: "btn btn-primary" %>

      <%= link_to "キャンセル",
        songs_path,
        class: "btn btn-outline" %>
    </div>
  <% end %>
</div>