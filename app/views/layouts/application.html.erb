<!DOCTYPE html>
<html>
  <head>
    <title>TagTune</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- ヘッダー（フル幅） -->
    <%= render "shared/header" %>

    <!-- メイン（左右余白あり） -->
    <main>
      <% if notice %>
        <p class="notice"><%= notice %></p>
      <% end %>

      <% if alert %>
        <p class="alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>