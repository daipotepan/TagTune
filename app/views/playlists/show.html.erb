<h1 class="page-title"><%= @playlist.name %></h1>

<p class="description"><%= @playlist.description %></p>

<%= link_to "＋ 曲を追加", songs_path, class: "add-song-btn" %>

<% if @playlist.songs.any? %>
  <div class="table-wrapper">
    <table class="songs-table">
      <thead>
        <tr>
          <th>タイトル</th>
          <th>アーティスト</th>
          <th>Spotify</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @playlist.songs.each do |song| %>
          <tr>
            <td><%= song.title %></td>
            <td><%= song.artist %></td>
            <td>
              <%= link_to "▶ 開く", song.spotify_url, target: "_blank", rel: "noopener" %>
            </td>
            <td>
              <%= link_to "🗑", playlist_song_path(song.playlist_songs.find_by(song: song)), method: :delete, data: { confirm: "本当に削除しますか？" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>まだ曲が追加されていません</p>
<% end %>