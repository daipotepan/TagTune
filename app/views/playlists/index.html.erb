<h1 class="page-title">🎶 プレイリスト一覧</h1>

<% if user_signed_in? %>
  <%= link_to "＋ 新規プレイリスト", new_playlist_path, class: "btn btn-primary mb-3" %>
<% end %>

<% if @playlists.any? %>
  <div class="playlist-list">
    <% @playlists.each do |playlist| %>
      <div class="playlist-card">
        <h2><%= link_to playlist.name, playlist_path(playlist) %></h2>
        <p class="description"><%= playlist.description %></p>
      </div>
    <% end %>
  </div>
<% else %>
  <p>プレイリストがありません</p>
<% end %>