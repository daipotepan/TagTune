<div class="playlist-form-card">
  <%= form_with model: playlist, local: true do |f| %>
    <% if playlist.errors.any? %>
      <div class="form-errors">
        <p>入力内容を確認してください</p>
        <ul>
          <% playlist.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :name, "プレイリスト名" %>
      <%= f.text_field :name,
        placeholder: "例：夜に聴きたい曲",
        class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :description, "説明" %>
      <%= f.text_area :description,
        rows: 4,
        placeholder: "このプレイリストについて",
        class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= f.submit playlist.new_record? ? "作成" : "更新",
        class: "btn btn-primary" %>

      <%= link_to "キャンセル",
        playlists_path,
        class: "btn btn-outline" %>
    </div>
  <% end %>
</div>